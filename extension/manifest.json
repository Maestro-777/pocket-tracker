{
  "manifest_version": 3,
  "name": "Pocket Tracker — Signal Monitor",
  "version": "1.2.1",
  "description": "Монитор состояния Pocket Option без перехвата WebSocket. Торговля заблокирована.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "https://pocketoption.com/*",
    "https://*.pocketoption.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Pocket Tracker — статус", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": [
        "https://pocketoption.com/*",
        "https://*.pocketoption.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}