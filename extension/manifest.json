{
  "manifest_version": 3,
  "name": "Pocket Tracker",
  "version": "2.0.0",
  "description": "Поиск сигналов BB/RSI и DEMO-торговля Pocket Option.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://demo-api-eu.po.market/*",
    "https://try-demo-eu.po.market/*",
    "https://pocketoption.com/*",
    "https://*.pocketoption.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Pocket Tracker",
    "default_popup": "popup.html"
  }
}