{
  "manifest_version": 3,
  "name": "Pocket Tracker — Signal Monitor",
  "version": "1.1.0",
  "description": "Панель диагностики соединения Pocket Tracker и Pocket Option, уведомления о сигналах.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://pocketoption.com/*",
    "https://*.pocketoption.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Pocket Tracker — статус",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pocketoption.com/*",
        "https://*.pocketoption.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
