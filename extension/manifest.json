{
  "manifest_version": 3,
  "name": "Pocket Tracker",
  "version": "3.1.0",
  "description": "Pocket Option DEMO: 5s BB/RSI signals, verified DEMO stream and guarded 15s orders.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://pocketoption.com/*",
    "https://*.pocketoption.com/*",
    "https://p.finance/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pocketoption.com/*",
        "https://*.pocketoption.com/*",
        "https://p.finance/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pocketoption.com/*",
        "https://*.pocketoption.com/*",
        "https://p.finance/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "Pocket Tracker",
    "default_popup": "popup.html"
  }
}
