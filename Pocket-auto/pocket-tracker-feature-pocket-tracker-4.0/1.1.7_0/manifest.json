{
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "js": [
        "js/content-main.js"
      ],
      "matches": [
        "https://pocketoption.com/*",
        "https://platform58.po2.capital/*",
        "https://p.finance/*",
        "https://po.company/*",
        "https://po1.capital/*",
        "https://pocket-link22.co/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": [
        "js/content-isolated.js"
      ],
      "matches": [
        "https://pocketoption.com/*",
        "https://platform58.po2.capital/*",
        "https://p.finance/*",
        "https://po.company/*",
        "https://po1.capital/*",
        "https://pocket-link22.co/*"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "default_locale": "en",
  "description": "Pocket Option trading bot",
  "host_permissions": [
    "https://pocketoption.com/*",
    "https://platform58.po2.capital/*",
    "https://p.finance/*",
    "https://po.company/*",
    "https://po1.capital/*",
    "https://pocket-link22.co/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "manifest_version": 3,
  "name": "Pocket Option Bot",
  "permissions": [
    "storage",
    "scripting"
  ],
  "version": "1.1.7",
  "web_accessible_resources": [
    {
      "matches": [
        "https://pocketoption.com/*",
        "https://platform58.po2.capital/*",
        "https://p.finance/*",
        "https://po.company/*",
        "https://po1.capital/*",
        "https://pocket-link22.co/*"
      ],
      "resources": [
        "css/shadow.css"
      ]
    }
  ]
}
