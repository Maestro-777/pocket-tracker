{
  "manifest_version": 3,
  "name": "Pocket Tracker Desktop",
  "version": "4.0.1",
  "description": "Desktop test build for Pocket Tracker background execution.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://pocketoption.com/*",
    "https://*.pocketoption.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pocketoption.com/*",
        "https://*.pocketoption.com/*"
      ],
      "js": ["inject.js", "background-probe.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pocketoption.com/*",
        "https://*.pocketoption.com/*"
      ],
      "css": ["css/bot-ui.css"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://pocketoption.com/*",
        "https://*.pocketoption.com/*"
      ],
      "js": ["account-mode.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}