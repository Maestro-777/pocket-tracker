{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "32": "icons/icon32.png",
         "64": "icons/icon64.png"
      },
      "default_title": "PocketOption Signal"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "inject.js" ],
      "matches": [ "https://pocketoption.com/*", "https://*.pocketoption.com/*" ],
      "run_at": "document_start",
      "world": "MAIN"
   }, {
      "all_frames": true,
      "css": [ "css/bot-ui.css" ],
      "js": [ "market/ext-host.js", "content.js", "market/qrcode.js", "market/market.js" ],
      "matches": [ "https://pocketoption.com/*", "https://*.pocketoption.com/*" ],
      "run_at": "document_start"
   } ],
   "description": "Конструктор сигналов для Pocket Option: свечной анализ, 10 индикаторов, автоторговля и журнал. Бесплатно.",
   "host_permissions": [ "https://pocketoption.com/*", "https://*.pocketoption.com/*", "https://pocketoption-signal.online/*" ],
   "icons": {
      "128": "icons/icon128.png",
      "32": "icons/icon32.png",
      "64": "icons/icon64.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "PocketOption Signal",
   "optional_host_permissions": [ "*://*/*" ],
   "permissions": [ "storage", "tabs", "windows", "scripting", "alarms" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "3.6.0",
   "web_accessible_resources": [ {
      "matches": [ "https://pocketoption.com/*", "https://*.pocketoption.com/*" ],
      "resources": [ "inject.js", "panel/panel.html", "panel/panel.js", "panel/panel.css" ]
   } ]
}
